{
  "manifest_version": 3,
  "name": "LeetTube – YouTube Solutions for LeetCode",
  "short_name": "LeetTube",
  "version": "1.0",
  "description": "Watch the best YouTube solution videos directly inside LeetCode problems.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://leetcode.com/*",
    "https://www.googleapis.com/*",
    "http://localhost:8080/*",
    "https://*.hf.space/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
